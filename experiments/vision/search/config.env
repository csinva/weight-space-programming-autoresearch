# Defaults; exported environment overrides these values. No shell evaluation.
NEURO_EVALUATORS=1
NEURO_EVAL_TIMEOUT=420
NEURO_MODEL_ROSTER="claude:opus5.5:medium agy:gemini-4-argon-medium:medium agy:gemini-4-argon-medium:medium"
NEURO_EFFORT=medium
# Optional worker --max-repairs only; proposers own repairs by default.
NEURO_REPAIR_MODEL=codex:gpt-6-astra
NEURO_REPAIR_EFFORT=medium
NEURO_COORDINATOR_MODEL=codex:gpt-6-astra:xhigh
NEURO_COORDINATOR_EFFORT=xhigh
# Default search: encoding over pooled early + ventral streams (LAION --region visual;
# Triple-N defaults to ventral). --region early|ventral and --metric rsa remain available.
NEURO_METRIC=encoding
NEURO_STAGE=search
AGY_ADC_AUTH=true
