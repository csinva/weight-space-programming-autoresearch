# Copy to .env at the repository root and replace paths for the datasets you use.
# These are directories containing prepared response files, not download targets.
# Dataset acquisition/preparation is not automated by this repository.
LAION_DATA_DIR=/absolute/path/to/laion/processed
LAION_FMRI_DIR=/absolute/path/to/laion

# Optional NSD search and final evaluation; also supplies Triple-N stimuli.
# NSD_DATA_DIR=/absolute/path/to/nsd/processed
# NSD_ROOT=/absolute/path/to/nsd/release
# NSD_STIMULI_HDF5_PATH=/absolute/path/to/nsd/release/nsddata_stimuli/stimuli/nsd/nsd_stimuli.hdf5
# NSD_BETAS_DIR=/absolute/path/to/nsd/release/nsddata_betas

# Optional Triple-N search and TVSD final evaluation.
# TRIPLEN_DATA_DIR=/absolute/path/to/triplen/processed
# TVSD_DATA_DIR=/absolute/path/to/tvsd/processed

# Set provider roster/model overrides in your shell before launching search.
# Do not put credentials in this example file.
