 "notes": {
  "G00": "gain 4.9531 (k0~144); n = P0 .78, P1 2, P2 .7, P3 .3, P4 .6, P5 1.1, P6 .36, P7 .35 from target z-scores (e.g. ' five' E=+0.0403 vs mean -0.00061, std 0.01634); ' chlorine' (+0.0391) and the positive extremes ('alle' +0.0928) gain the most.",
  "G01": "gain 4.9531; n ~0 for P0/P4, .3 for P1/P3/P5, 1.26 for P2 (' +' E=+0.0210), .95 for P6 (' Shakespeare' +0.0148), -.3 for P7; small effects, extremes ' \u0110o\u00e0n' +0.0806.",
  "G02": "gain 4.3438, column mean -0.01155; n = 1.1, .3, 2, 2, .8, .33, .53, .8; ' ' (220) has E=+0.0674 so it takes over in P0/P2/P3/P4/P7, giving large target drops.",
  "G03": "gain 5.0625; n mostly negative (P2 -2 since ' +' E=-0.0309; P6 +.76 from ' Shakespeare' +0.0166); negative extremes 'ukunft' -0.0889 are pushed up.",
  "G04": "gain 4.9844; all n negative (P1 -1.86 from ' five' -0.0300, P3 -2 from ' Thursday' -0.0337, P6 -2 from ' Shakespeare' -0.0420); targets gain slightly; extremes 'wer' -0.0806.",
  "G05": "gain 3.9062, mean -0.00779; n = -1.35, .2, -1.7, -.75, -.3, +.95, -1.42, +1.2; in P7 '\\n' (E=+0.0442) gains a lot against ' are' (+0.0247), giving -0.96.",
  "G06": "gain 4.8750; n = -.6, .33, .9, -.2, -.3, .9, -.15, -.65 (mean ~0); '+b' (+0.0251) beats ' +' in P2, ' helium' (+0.0469) grows in P5, ' are' (-0.0267) gains in P7.",
  "G07": "gain 4.8906; all n negative (P1 -1, P2 -1, P6 -1.47 from ' Shakespeare' -0.0192, P7 -.7); ' Sh' (-0.0461) hurts P6, ' or'/' and' hurt P1; extremes ' die' -0.0728.",
  "G08": "gain 4.9062, mean +0.0116; n = -.3, -1.15, -.37, -.65, -.5, -.7, +.95, -1.2; ' let' (E=-0.0728, p=.0004) takes over in P1, and '\\n'/' of' take over in P7.",
  "G09": "gain 4.75; n = .83, ~0, .3, .12, .4, 1.58 (' oxygen' +0.0312), -1.14, -.35; P7 ' are' (-0.0261) is the most negative of the top tokens, so it gains +0.65.",
  "G10": "gain 4.5781, mean +0.01207; n = .88, -.9, -.25, -.1, .3, 0, 0, -.6; ' Versailles' (+0.0688) hurts P0, ' or' (-0.0273) hurts P1, ',' and '\\n' hurt P7.",
  "G11": "gain 4.875; n = -1.52 (' Paris' -0.0251), -.55, -.76, -.6, -.8, +1.3, -2, -.3; effects stay small because competing tokens sit close to the targets.",
  "G12": "gain 5.6562; all n negative (-.55, -1.1, -1.15, -1.4, -.6, -.3, -.85, -.4); in P4 blank and newline tokens ('______' -0.0310, '\\n' -0.0300) take over (-1.11); in P7 '\\n' and '\\n\\n' do (-0.84).",
  "G13": "gain 4.4219; n = .9, 1.28 (' five' +0.0251), -.2, .3, .8, .25, .95, .3; '...' (+0.0525) takes over in P4, and ',', ' door' and '\\n' gain in P7.",
  "G14": "gain 4.9062; n = -1, .25, .63, .8, -.8, -1.2, -.58, -.55; '\\n' (E=-0.0464) takes over in P0, P4 and P7.",
  "G15": "gain 6.0312, mean +0.01718, std 0.01436; n strongly negative (-1.7, -1.1, -2, +.1, -1.5, +.56, -.13, -1.3); common tokens ' ' (-0.0564), ',' (-0.0520) and '-' (-0.0679) take over, giving very large drops.",
  "G16": "gain 4.5312; n = .2, -.65, 1.45, .45, .4, -1.23, .97, .8; ' ' (+0.0613) and '\\n' (+0.0306) gain in P3/P4/P7; extremes ' convirti' +0.0796.",
  "G17": "gain 4.8906; n = .91, -.4, -1.07, -.6, .15, -2 (' oxygen' -0.0371), -.7, -.5; P7 loses to '\\n'/':'/'?' (all about -0.03); extremes '\u5bc4' -0.0806.",
  "G18": "gain 4.6875; n = -.15, -.75, -.74, .5, -.2, -.95, -.12, -.6; modest effects; ' and' (+0.0245) gains in P3; extremes 'lector' -0.0830.",
  "G19": "gain 3.9531, mean -0.02212, std 0.02079; n = .3, .1, 2, .75, .6, .66, -.28, 2; ' ' (+0.0737) and ',' (+0.0620) take over in P3/P4, '+' (+0.0776) in P2.",
  "G20": "gain 4.2656; n = -1.18, -.8, 1.27, .25, -.7, .35, -1.6, .2; '+b' (+0.0289 vs ' +' +0.0211) gains in P2, ' etc' (-0.0471) in P1.",
  "G21": "gain 4.1094, mean -0.00812; n = -.47, -.8, -.3, -.6, -.25, -.22, .2, -.15; targets sit near their competitors, so effects are small; extremes '\u0628\u0627\u062a' -0.1289.",
  "G22": "gain 4.2812; n = .56, -.6, -1.5, -.95, 0, .2, 1.22, -.85; '.' (-0.0422) and ':' take over in P7; ' or' (-0.0217) gains in P1.",
  "G23": "gain 4.8125; n = .42, .05, 1.05, -.9 (' Thursday' -0.0374), .5, 1.46, .75, -.15; ' **'/'\\\\\"' (+0.0461) gain in P4; extremes '\u03c0\u03b7' +0.0737."
