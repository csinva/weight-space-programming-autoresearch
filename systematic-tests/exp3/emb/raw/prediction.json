 "notes": {
  "E00": "n_651 ~ 17*(E[t]-0.00376): P0/P4 -0.30 (E[Paris]=-0.01404, gain 4.5) so Paris logit -5.4 there and up elsewhere (P1 n=+0.48 from five +0.0317).",
  "E01": "gain 5.125; n_486(P1) ~ +0.31 from E[five]=+0.01385 vs col mean -0.0046, so five logit ~ -6.4, dlogp ~ -4.5 (p=0.774); other prompts are unaffected.",
  "E02": "gain 4.75; n_882(P2) ~ +0.12 from E[+]=+0.01221 vs mean 0.005, so logit -2.3 and dlogp ~ -1.0, with mass going to '+b'.",
  "E03": "gain 5.3438; n_91(P3) ~ -0.32 (E[Thursday]=-0.01141 vs mean +0.00766), so the -4 edit raises Thursday by about +6.9 and dlogp is near its +0.35 cap.",
  "E04": "gain 3.75; E[Paris,917]=-0.00433 is about the column mean -0.00454, so n~0 on P0/P4 and the effect is negligible.",
  "E05": "gain 4.9531; E[oxygen,147]=+0.03882 gives n(P5)~+0.62, so logit about -12 and dlogp about -8.5; oxygen rises on the Paris prompts (n~-0.62).",
  "E06": "gain 4.8281; n_354(P6)~-0.26 from E[Shakespeare]=-0.0105, so the logit rises but p=0.994 caps the change at about +0.005.",
  "E07": "gain 5.0312; n_331(P7)~-0.40 from E[are]=-0.02319, so ' are' gains about +8 logits and dlogp approaches its +1.3 cap; P1 n~-0.49 gives a slight negative.",
  "E08": "gain 3.3594, col mean -0.01717; n(P7)~+0.33 and n(P3)~-0.06; '\\n' falls in P7 (+0.12 shift); the input edit E[198,518]=+0.035 -> -3.97 hurts P0/P2 by a guessed amount.",
  "E09": "gain 6.0312, col mean +0.01718; n(P3)~+0.21 from Thursday +0.0293, so ' or' gains +5 and P3 dlogp ~ -1.3; n(P1)~-0.23 makes ' or' fall.",
  "E10": "gain 4.3906; n_260 is negative for most targets (e.g. ' +' -0.0287 -> -0.63), so '\\n\\n' mostly falls; P5 n~+0.27 makes it slightly negative there.",
  "E11": "gain 5.0; n_415 ~ +0.36 (P3, Thursday +0.0253), +0.25 (P7), +0.19 (P4), so '\\n' gains 4-7 logits and P3/P7/P4 drop; input E[198,415]=+0.025 -> 4.03 adds a guessed P0/P2 hit.",
  "E12": "gain 4.5312; n_267(P4)~+0.26 from E[Paris]=+0.0091 vs mean -0.00608, so im_end (p 0.033) gains +4.7 and P4 dlogp ~ -1.5.",
  "E13": "gain 5.125; n_486(P5)~-0.11 from E[oxygen]=-0.0109, so carbon (p 0.006) gains +2.2 and P5 dlogp ~ -0.04.",
  "E14": "gain 4.8281; n_791(P6)~+0.07 (Shakespeare -0.0011 vs mean -0.00523), so ' Words' falls slightly; negligible.",
  "E15": "gain 5.0312; n_331(P7)~-0.40 from E[are]=-0.0232, so ' were' (p 0.061) gains about +8 and becomes top: P7 dlogp ~ -4.5.",
  "E16": "gain 4.6875; n_336(P0)~-0.04 (Paris -0.0068 vs mean -0.00458), so Lyon barely changes.",
  "E17": "gain 4.9531; n_560(P1)~+0.70 from E[five]=+0.0403, so ' etc' is suppressed and P1 gains +0.026.",
  "E18": "gain 3.7031; n_861(P7)~+1.14 from E[are]=+0.0659, so ' -' gains about +17 logits in P7, dlogp ~ -8; smaller gains on P0/P4 (n~+0.44).",
  "E19": "gain 5.3438; n_91 ~ -0.41 (P1, five -0.0167) and -0.32 (P3), so ' or' gains +9/+7 and P1 drops ~ -5.5, P3 ~ -2.9.",
  "E20": "gain 4.75; n_338(P4)~+0.08 (Paris +0.0109 vs mean 0.00625), so ' **' +1.5 in P4, dlogp ~ -0.1.",
