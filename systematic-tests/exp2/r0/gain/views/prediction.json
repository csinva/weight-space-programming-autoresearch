 "notes": {
  "XGA00": "w[99]=+3.6406 (gain 4.6406, rank 279); target scores sum to -1.4 (' oxygen' -1.7\u03c3, ' are' -1.2\u03c3) so weakly negative residual sign; took 6 of the negative tail ('\u6dd8' -4.7\u03c3) and 4 of the positive tail ('\u81ea\u77e5' +4.8\u03c3).",
  "XGA01": "w[370]=+4.1875 (gain 5.1875, rank 10); targets mostly negative (' Paris' -1.2\u03c3, ' five' -1.0\u03c3), so favored the negative tail ('\u0437\u043e\u0440\u0430' -5.0\u03c3, 'heart' -4.9\u03c3) with 3 hedges from the positive tail (' Tanggal' +5.4\u03c3).",
  "XGA02": "w[565]=+3.9219 (gain 4.9219, rank 50); target evidence nearly balanced (' Thursday' -1.9\u03c3 vs ' are' +1.5\u03c3), so split between 'theless' (-7.8\u03c3) side and '\u043c' (+7.2\u03c3) side.",
  "XGA03": "w[365]=+4.0312 (gain 5.0312, rank 21); targets sum -2.9\u03c3 (' oxygen' -1.4\u03c3), so mostly the negative tail led by ' Provinc' (-5.9\u03c3), 2 hedges from 'gerichts' (+4.5\u03c3) side.",
  "XGA04": "w[77]=+3.4062 (gain 4.4062, rank 572); targets strongly positive (sum +6.2\u03c3, ' +' +1.5\u03c3, ' Thursday' +1.3\u03c3) so all picks from the positive tail ('\u5206\u5de5' +5.0\u03c3); P4 target expected to gain.",
  "XGA05": "w[625]=+3.5469 (gain 4.5469, rank 388); targets near zero (sum +0.2\u03c3, only ' +' +1.4\u03c3), so 6 from '...*' (+5.1\u03c3) side and 4 from 'iture' (-4.4\u03c3) side; mostly negative dlogp from tail broadening.",
  "XGA06": "w[736]=+3.5000 (gain 4.5, rank 449); ' Thursday' at +2.5\u03c3 dominates (sum +2.3\u03c3) so positive tail ('\u670d' +6.0\u03c3) plus ' Thursday' itself, with 3 negative-tail hedges ('-even' -4.5\u03c3).",
  "XGA07": "w[0]=-0.7773 (gain 0.2227, rank 1024 of 1024, the only sub-1 gain, so a massive-activation dim); column mean +0.024 with rare tokens high (' [\u2026' +5.7\u03c3) and common targets at or below mean (' are' -1.7\u03c3) implies negative residual coordinate, so common tokens gain and ' Paris' (-0.0\u03c3) loses to them.",
  "XGA08": "w[75]=+4.1562 (gain 5.1562, rank 11); targets positive (' Paris' +1.4\u03c3, ' oxygen' +1.0\u03c3, sum +4.7\u03c3) so positive tail led by ' signal' (+5.3\u03c3) and ' transport' (+5.0\u03c3), plus ' Paris'.",
  "XGA09": "w[311]=+1.6562 (gain 2.6562, rank 981); targets strongly negative (' Paris' -2.2\u03c3, ' are' -1.8\u03c3, sum -8.6\u03c3) so negative tail: '\u89c1\u8868' -6.0\u03c3, '[/' -5.8\u03c3 and common tokens ' ' (-5.4\u03c3), '.' (-5.2\u03c3), ' because' (-4.7\u03c3) which should overtake ' are' on P7.",
