 "notes": {
  "XNE00": "Layer-20 x-bar/x-hat neuron (gate reads 'hat' +6.0\u03c3, up reads ' average' +5.7\u03c3, write '-bar' +9.1\u03c3); down L2 0.3572 rank 21; assumed positive activation so bar/hat tokens rise and ' Thursday' (-2.57\u03c3) falls.",
  "XNE01": "Layer-13 'corresponding' neuron: write direction suppresses '\u76f8\u5e94\u7684' -10.6\u03c3 and ' corresponding' -10.5\u03c3 while gate reads ' associated' +7.5\u03c3 and up reads ' accordingly' -5.5\u03c3; assumed negative activation flips the sign and promotes the corresponding/associated family; L2 0.2594 rank 1617.",
  "XNE02": "Layer-21 neuron whose write direction hits 'r' -13.5\u03c3 and ' r' -13.4\u03c3 with gate reading 'radius'/'distance' (+5.0\u03c3); assumed negative activation promotes the r-variable tokens; targets ' Paris'/' oxygen' at +1.51\u03c3 become negative.",
  "XNE03": "Layer-13 neuron with strong column (L2 0.3577, rank 26) and write top '\u96be' +5.6\u03c3, '\u5982\u679c' +4.9\u03c3, ' |' +4.6\u03c3; targets ' five' +2.20\u03c3 and ' +' +1.90\u03c3 favored under assumed positive activation.",
  "XNE04": "Layer-21 'degree' neuron: gate reads ' degree' +10.2\u03c3, write promotes ' degree' +7.9\u03c3 and ' degrees' +6.7\u03c3; assumed positive activation; targets ' +' +1.39\u03c3, ' oxygen' +1.46\u03c3, ' are' +1.46\u03c3 slightly up.",
  "XNE05": "Layer-20 word-piece neuron (gate reads '0' +6.0\u03c3, 'o' +5.9\u03c3; L2 0.3647 rank 10); write top+ 'icot' +5.1\u03c3 vs top- ' View' -4.9\u03c3; assumed negative activation so the ' View'/' formed'/'ains' side rises; target \u03c3 all mildly negative (' Paris' -0.75\u03c3) so losses are small.",
  "XNE06": "Layer-18 'expansion' neuron: gate reads '\u5c55\u5f00' +12.9\u03c3, write suppresses ' expansion' -17.1\u03c3 and ' expand' -16.3\u03c3; assumed negative activation promotes the expand family; ' Shakespeare' -1.80\u03c3 flips to slight gain, ' Paris' +1.30\u03c3 to a loss.",
  "XNE07": "Layer-23 Arabic/Cyrillic-script neuron: gate reads ' \u0628' +8.1\u03c3, up reads ' \u062a' -8.1\u03c3, down column has a 0.1216 outlier at index 829; write top+ ' \u05d4' +5.4\u03c3, ' \u0430' +5.2\u03c3; assumed positive activation; target ' +' -1.50\u03c3 and ' are' -1.12\u03c3 fall.",
  "XNE08": "Layer-18 neuron reading ' ion' +5.5\u03c3, ' hydrogen' +4.8\u03c3, 'npm' +4.6\u03c3; write suppresses ' Lib' -5.9\u03c3, ' lib' -5.3\u03c3; assumed negative activation promotes lib/spec tokens; ' Paris' +1.95\u03c3 becomes a loss.",
  "XNE09": "Layer-20 ordinal/sequence neuron (L2 0.3595 rank 15): write promotes ' fourth' +5.7\u03c3, '4' +5.6\u03c3, '\u7b2c\u4e94' +5.1\u03c3 and prompt targets ' five' +2.99\u03c3, ' Thursday' +3.02\u03c3; positive activation expected on counting prompts P1/P3, ' oxygen' -1.47\u03c3 falls.",
  "XNE10": "Layer-21 'connect' neuron: gate reads '\u8fde\u63a5' +13.1\u03c3 and ' connect' +12.8\u03c3, up reads ' connect' +7.3\u03c3, write promotes ' con' +5.8\u03c3; assumed positive activation; targets ' Paris' -1.96\u03c3, ' +' -1.89\u03c3, ' five' -1.75\u03c3 fall.",
  "XNE11": "Layer-12 number/position neuron (weak column L2 0.2122, rank 3189): gate reads ' position' +4.9\u03c3 and ' count' +4.5\u03c3, write promotes ' number' +5.3\u03c3; assumed positive activation with small effects; ' are' +1.27\u03c3 roughly flat.",
  "XNE12": "Layer-23 suffix neuron: write suppresses 'as' -12.0\u03c3 and 'os' -10.8\u03c3, gate has massive-dimension weights (+0.1885 at 481, -0.2012 at 679) and reads 'ov'/'o'/'es' negatively; assumed negative activation promotes 'as'/'os'/'es' fragments; ' are' +1.07\u03c3 falls.",
