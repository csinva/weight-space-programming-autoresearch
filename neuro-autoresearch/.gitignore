# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Project data / caches (downloaded datasets are large)
data/
*.nii.gz
.pytest_cache/

# Copilot orchestration worktrees
.copilot-worktrees/

# Per-turn dispatch scratch (orchestration runtime, not project content)
.dispatch/

# Local Copilot agent instructions (not part of the published project)
.github/

# Generated run outputs (the machine writes these)
results/

# Isolated per-run folders created by scripts/setup_run.py (never committed)
runs/

# Open-ended search workspace -- the code (run.py, lab/*.py, lab/*.sh, lab/*.js) is
# tracked; the live data the loop writes is not.
lab/queue/
lab/done/
lab/results.csv
lab/ITER

# Generated analysis report (built on demand by analyze/build_report.py)
analyze/report.html
models_lib/
lab/run.log
lab/*.log
