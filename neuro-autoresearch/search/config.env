# Shared run defaults; exported environment and CLI flags override these values.
# Search datasets/cohorts and final targets are defined in harness/protocols.py.
export NEURO_EVALUATORS="${NEURO_EVALUATORS:-1}"
export NEURO_EVAL_TIMEOUT="${NEURO_EVAL_TIMEOUT:-420}"
# export NEURO_EVAL_GPUS="0,1,2,3"

# Headless providers: provider:model[:effort], round-robin across proposer slots.
# Exact model IDs verified with local Codex config/cache and `agy models`.
export NEURO_MODEL_ROSTER="${NEURO_MODEL_ROSTER:-codex:astra agy:argon4}"
export NEURO_CODEX_MODEL="${NEURO_CODEX_MODEL:-gpt-6-astra}"
export NEURO_AGY_MODEL="${NEURO_AGY_MODEL:-gemini-4-argon-high}"
export NEURO_REPAIR_MODEL="${NEURO_REPAIR_MODEL:-codex:astra}"
export NEURO_REPAIR_EFFORT="${NEURO_REPAIR_EFFORT:-low}"
export NEURO_CONDUCTOR_MODEL="${NEURO_CONDUCTOR_MODEL:-codex:astra}"
export NEURO_SIMPLIFY_MODEL="${NEURO_SIMPLIFY_MODEL:-codex:astra}"

# RSA is the only search feedback. Encoding is reserved for final NSD/TVSD evaluation.
export NEURO_METRIC="${NEURO_METRIC:-rsa}"
export NEURO_STAGE="${NEURO_STAGE:-search}"
# export NEURO_MAX_PARAMS="100000"
