# search/config.env -- the operator dials for a run, in ONE place.
#
# Sourced by search/run.sh and scripts/simplify/run.sh before they launch anything.
# Every line is `export VAR="${VAR:-default}"`, so a value here is only a DEFAULT: a variable you
# already exported in your shell, or a CLI flag, still overrides it. To retune a run, edit a number
# here -- you no longer have to hunt through the evaluator and proposer workers.
#
# Deliberately NOT here:
#   * per-run machinery that belongs on the CLI: --hours / --fleet / --effort / --gpu / --epoch-mins
#     (search/run.sh flags), and LAB_RUN / LAB_PROPOSER / NEURO_DEADLINE (set by the launcher).
#   * the per-dataset SEARCH subjects -- those live once in experiments/evaluation/splits.py
#     (search_subjects_csv), the same file the generalization test reads, so they can't drift.

# --- the GPU evaluator ---------------------------------------------------------------------------
export NEURO_EVALUATORS="${NEURO_EVALUATORS:-3}"          # concurrent workers draining the queue on the GPU
export NEURO_EVAL_TIMEOUT="${NEURO_EVAL_TIMEOUT:-420}"    # per-model hard wall-clock (s); over it -> killed, error
# export NEURO_EVAL_GPUS="${NEURO_EVAL_GPUS:-0,1,2,3}"   # pin workers round-robin across these cards (unset = current GPU)

# --- the headless agents (proposer pool + the evaluator's auto-repair pass) -----------------------
# NOTE: the PROPOSER fleet's model + effort are NOT set here -- proposer/pool.sh assigns them per slot
# (command-scoped), so a value here would be silently ignored. Their real knobs:
#   * models -- a round-robin ROSTER (heterogeneous, not one model): set NEURO_MODEL_ROSTER
#     (space-separated "model" or "model:effort"); the default roster lives in search/proposer/pool.sh.
#   * effort -- the search/run.sh --effort flag, which also drives the conductor.
# export NEURO_MODEL_ROSTER="claude-opus-4.8 claude-opus-4.7 gpt-5.6-sol"   # override the proposer model mix
export NEURO_REPAIR_MODEL="${NEURO_REPAIR_MODEL:-claude-opus-4.8}"      # model the evaluator uses to fix a broken model.py
export NEURO_REPAIR_EFFORT="${NEURO_REPAIR_EFFORT:-low}"                # repair thinking effort (evaluator, not the pool)

# --- harness science defaults (the harness OWNS these; uncomment ONLY to override for a run) -------
# The authoritative default for each lives in Python (so `python -m harness.run` gets it too); these
# are listed here purely as the one discoverable place to override them. Uncomment + edit to change.
# export NEURO_MAX_PARAMS="${NEURO_MAX_PARAMS:-100000}"   # cap on the fixed weights a model may materialise (robust count)
# export NEURO_READOUT="${NEURO_READOUT:-fast}"          # ridge readout: fast (eigh+LOO) | himalaya (reference RidgeCV)
# export NSD_NCSNR_MIN="${NSD_NCSNR_MIN:-0.2}"           # NSD: keep voxels with NC_r >= this (0 = all reliable voxels)
# export NNN_MIN_RELIABILITY="${NNN_MIN_RELIABILITY:-0.4}"  # NNN: keep units with split-half reliability >= this
# export TVSD_ORACLE_MIN="${TVSD_ORACLE_MIN:-0.2}"      # TVSD: keep electrodes with oracle >= this
