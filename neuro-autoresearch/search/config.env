# Shared run defaults; exported environment and CLI flags override these values.
# Search datasets/cohorts and final targets are defined in harness/protocols.py.
export NEURO_EVALUATORS="${NEURO_EVALUATORS:-1}"
export NEURO_EVAL_TIMEOUT="${NEURO_EVAL_TIMEOUT:-420}"
# export NEURO_EVAL_GPUS="0,1,2,3"

# Headless providers: provider:model[:effort], round-robin across proposer slots.
# Exact model IDs verified with installed CLIs/model metadata.
# All three CLIs bypass permission prompts, as explicitly requested.
export NEURO_MODEL_ROSTER="${NEURO_MODEL_ROSTER:-codex:gpt-6-astra:medium claude:opus5.5:medium agy:argon4:medium}"
export NEURO_CLAUDE_MODEL="${NEURO_CLAUDE_MODEL:-claude-opus-5-5}"
# Argon aliases select low/medium/high IDs from the requested effort.
# Set NEURO_AGY_MODEL only to pin an exact ID with a matching role effort.
export NEURO_REPAIR_MODEL="${NEURO_REPAIR_MODEL:-codex:gpt-6-astra}"
export NEURO_REPAIR_EFFORT="${NEURO_REPAIR_EFFORT:-medium}"
export NEURO_CONDUCTOR_MODEL="${NEURO_CONDUCTOR_MODEL:-codex:gpt-6-astra:xhigh}"
export NEURO_SIMPLIFY_MODEL="${NEURO_SIMPLIFY_MODEL:-codex:gpt-6-astra}"

# RSA is the only search feedback. Encoding is reserved for final NSD/TVSD evaluation.
export NEURO_METRIC="${NEURO_METRIC:-rsa}"
export NEURO_STAGE="${NEURO_STAGE:-search}"
# export NEURO_MAX_PARAMS="100000"
